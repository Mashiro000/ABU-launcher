<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Keep existing local media-server HTTP support. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Apple's Aerial CDN uses its private Apple Root CA, absent from Android's store.
         This additional public anchor applies only to this exact CDN hostname.
         TLS chain, validity and hostname verification remain enabled. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">sylvan.apple.com</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/apple_root_ca" />
        </trust-anchors>
    </domain-config>
</network-security-config>
